{
  "id": "./start.html",
  "name": "Cassie — Study Tutor",
  "short_name": "Cassie",
  "description": "A free AI study buddy that explains any subject step by step, draws graphs, quizzes you, and makes reviewers from your files.",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity"
  ],
  "start_url": "./start.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#100f16",
  "theme_color": "#1c1c24",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screens/phone-home.png",
      "sizes": "1082x1922",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cassie's home screen"
    },
    {
      "src": "icons/screens/phone-graph.png",
      "sizes": "1082x1922",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cassie draws a graph on her board"
    },
    {
      "src": "icons/screens/wide-graph.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Cassie on a computer"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".docx",
            ".pptx",
            ".txt",
            "text/plain"
          ]
        }
      ]
    }
  }
}
