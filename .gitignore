# Build artifacts (generated for Chrome Web Store upload, not source)
*.zip
cassie-extension-*.zip
cassie-screenshot-*.png

# test dependencies
tests/node_modules/
_site/

# never commit secrets (API keys belong in the Cloudflare Worker settings, not in files)
.env
.env.*
.dev.vars
*.pem
*.key
promo/hero/raw/

# promo videos and voice-overs live outside git (the site ships only promo/cassie-ad-60s.mp4, already tracked);
# new renders and recordings stay on your computer or in Drive instead of growing the repository
promo/**/*.mp4
promo/**/*.wav
promo/**/*.mov
